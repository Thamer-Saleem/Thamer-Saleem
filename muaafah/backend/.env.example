# Mua'afah Backend Configuration
# Copy this to .env and fill in the values

# API
APP_NAME=Muaafah
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Anthropic Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database
DATABASE_URL=sqlite+aiosqlite:///./muaafah.db

# Redis (for caching and sessions)
REDIS_URL=redis://localhost:6379

# NPHIES (Mock)
NPHIES_BASE_URL=https://api.nphies.sa
NPHIES_API_KEY=your-nphies-key

# Nafath SSO (Mock)
NAFATH_CLIENT_ID=your-nafath-client-id
NAFATH_CLIENT_SECRET=your-nafath-secret
NAFATH_REDIRECT_URI=http://localhost:3000/auth/callback

# SMS Gateway
SMS_GATEWAY_API_KEY=your-sms-key
SMS_GATEWAY_URL=https://api.unifonic.com

# Firebase (Push Notifications)
FIREBASE_SERVER_KEY=your-firebase-key

# File Storage
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,heic
